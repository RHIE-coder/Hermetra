{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/design-token-guard.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/immunity-rules-guard.mjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "steward@steward": true
  }
}
